{
  "manifest_version": 3,
  "name": "Chrome Live (for Antigravity)",
  "version": "1.0.0",
  "description": "Local zero-dependency bridge connecting your signed-in Chrome tabs and background tab groups to Antigravity with live screencast & financial guardrails.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Chrome Live Console",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "hud-early-guard.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "debugger",
    "scripting",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "sidePanel",
    "contextMenus",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:28196/*"
  ],
  "commands": {
    "toggle-share-tab": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Share or release the active tab for Chrome Live automation"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
